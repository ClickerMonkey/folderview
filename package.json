{
  "name": "folderview",
  "version": "0.1.0",
  "description": "Browse, search and review any folder in your browser: highlighted code, rendered markdown with mermaid and math, git status and diffs, full-text search, downloads, and review comments saved where an LLM can read them.",
  "type": "module",
  "bin": {
    "folderview": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "watch:client": "node scripts/build-client.mjs --watch",
    "dev": "npm run build && node dist/cli.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "screenshots": "node scripts/screenshots.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "file-browser",
    "file-viewer",
    "code-viewer",
    "markdown",
    "mermaid",
    "syntax-highlighting",
    "git",
    "diff",
    "code-review",
    "llm",
    "cli",
    "server"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "marked": "^18.2.0",
    "marked-footnote": "^1.4.0",
    "mermaid": "^12.3.0",
    "playwright": "^1.64.1",
    "shiki": "^4.6.0",
    "temml": "^0.14.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClickerMonkey/folderview.git"
  },
  "homepage": "https://github.com/ClickerMonkey/folderview#readme",
  "bugs": {
    "url": "https://github.com/ClickerMonkey/folderview/issues"
  },
  "author": "ClickerMonkey"
}
